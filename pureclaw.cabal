    age,
    aeson,
    async,
    base16-bytestring,
    base64-bytestring,
    bytestring,
    containers,
    crypton,
    directory,
    filepath,
    haskeline,
    http-client,
    http-client-tls,
    http-types,
    mcp-client,
    mcp-types,
    memory,
    mtl,
    network,
    optparse-applicative,
    posix-pty,
    process,
    sqlite-simple,
    stm,
    temporary,
    text,
    time,
    tomland,
    transformers,
    unix,
    typed-process,
    uuid,
    vector,
    wai,
    wai-extra,
    wai-websockets,
    warp,
    websockets,
